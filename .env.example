# NoEgos Auth service URL
AUTH_URL=http://localhost:5173

# This app's slug in the auth service
AUTH_APP_SLUG=ww-journal

# Cookie domain (match auth service)
COOKIE_DOMAIN=localhost

# Postgres connection (server sync target)
# Local dev (Unix socket): postgres://?host=/var/run/postgresql&port=5433&database=ww_journal
# Production: postgres://user:pass@host:5432/ww_journal
DATABASE_URL=postgres://?host=/var/run/postgresql&port=5433&database=ww_journal
